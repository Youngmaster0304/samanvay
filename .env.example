# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=samanvay
POSTGRES_USER=samanvay
POSTGRES_PASSWORD=samanvay_local_dev_only
DATABASE_URL=postgresql+psycopg://samanvay:samanvay_local_dev_only@localhost:5432/samanvay

# Storage CRS for the demo AOI. Chandigarh pilot: WGS84 / UTM zone 43N (EPSG:32643).
# Change per AOI and record the choice in docs/stage-N.md.
STORAGE_SRID=32643

# --- Redis (Celery broker and result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible object store) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=samanvay
MINIO_SECRET_KEY=samanvay_local_dev_only
MINIO_BUCKET=samanvay
MINIO_SECURE=false

# --- Service URLs used inside Docker Compose ---
API_DATABASE_URL=postgresql+psycopg://samanvay:samanvay_local_dev_only@postgis:5432/samanvay
API_REDIS_URL=redis://redis:6379/0
API_MINIO_ENDPOINT=minio:9000

# --- App ---
APP_ENV=dev
APP_VERSION=0.1.0
POLICY_PATH=/app/policies/naksha_default.yaml
# Public origin of the web app, used for CORS.
WEB_ORIGIN=http://localhost:3000

# --- Tile services ---
TITILER_PORT=8081
TILESERVER_PORT=7800
